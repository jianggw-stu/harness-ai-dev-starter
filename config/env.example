# ==============================================================================
# AI 研发全生命周期流水线 - 本地环境配置文件模板
# 请将本文件复制为 .env.local 或直接导出到您的 shell profile (~/.zshrc 或 ~/.bashrc)
# 注意：请将下方的所有 "xxx" 替换为您本机的真实配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Java 与 Maven 本地环境配置 (必需)
# ------------------------------------------------------------------------------
# 您的 JDK 11 根路径
export JAVA_HOME="/xxx/path/to/jdk-11"

# 您的 Maven 安装根路径 (建议 Maven 3.8+)
export MAVEN_HOME="/xxx/path/to/apache-maven-xxx"

# 您的 Maven 自定义 settings.xml 路径
export MAVEN_SETTINGS="/xxx/path/to/apache-maven-xxx/conf/settings.xml"

# 您的 Maven 本地仓库路径 (保持与 IDEA 中配置一致)
export MAVEN_REPO="/xxx/path/to/maven-work"

# ------------------------------------------------------------------------------
# 2. 本地测试 Docker MySQL 真实数据验证配置 (必需)
# ------------------------------------------------------------------------------
# 本机 Docker 容器名 (用于运行业务表落盘与前后值校验)
export LOCAL_TEST_DB_CONTAINER="xxx-mysql"

# 本机 MySQL 映射端口 (如 3306 或 3306)
export LOCAL_TEST_DB_PORT="xxx"

# 本机测试数据库库名 (对应微服务模块的表结构)
export LOCAL_TEST_DB_NAME="xxx_test_db"

# 本机测试数据库密码 (默认为 root)
export LOCAL_TEST_DB_PWD="xxx_password"

# ------------------------------------------------------------------------------
# 3. 团队协同平台配置 (GitLab / 工单系统)
# ------------------------------------------------------------------------------
# 团队自建 GitLab 域名 (如 gitlab.xxx.com)
export GITLAB_HOST="xxx.gitlab.com"

# 个人 GitLab 访问令牌 (可在 GitLab -> Preferences -> Access Tokens 生成，勾选 api 权限)
export GITLAB_TOKEN="xxx_personal_access_token"

# 工单系统地址 (如 PingCode 或 Jira 域名)
export WORK_ORDER_BASE_URL="https://xxx.pingcode.com"

# ------------------------------------------------------------------------------
# 4. AI 模型网关与 API Key 配置
# ------------------------------------------------------------------------------
# 大模型 API Base URL (如公司内部中转网关或官方地址)
export OPENAI_BASE_URL="https://api.xxx.com/v1"

# 模型调用 API Key
export OPENAI_API_KEY="sk-xxx"

# 需求分析指定的模型名称 (推荐: gpt-6-luna / claude-3-7-sonnet / deepseek-reasoner)
export MODEL_ANALYST="xxx_analyst_model"

# 代码实现指定的模型名称 (推荐: grok-4.7 / claude-3-7-sonnet)
export MODEL_DEVELOPER="xxx_developer_model"
